# Copy to .env. Values here are used unless the same variable is already set
# in the environment, and .env is git-ignored.

# A Slack user token. Set this and nothing is written to disk or the keychain,
# which is what makes a rebuilt development binary stop asking for a password.
SLACK_TOKEN=xoxp-...

# Logging. `slack_api=debug` shows every request and rate-limit wait.
RUST_LOG=slack_ui=info,slack_api=info
